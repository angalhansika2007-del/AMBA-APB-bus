module apb_bus_controller #(
    parameter ADDR_WIDTH = 32,
    parameter DATA_WIDTH = 32
)(
    input  wire                  PCLK,
    input  wire                  PRESETn,

    // User / Processor Interface
    input  wire                  start,
    input  wire                  write_enable,
    input  wire [ADDR_WIDTH-1:0] address,
    input  wire [DATA_WIDTH-1:0] write_data,

    output reg  [DATA_WIDTH-1:0] read_data,
    output reg                   done,

    // APB Master Interface
    output reg                   PSEL,
    output reg                   PENABLE,
    output reg                   PWRITE,
    output reg  [ADDR_WIDTH-1:0] PADDR,
    output reg  [DATA_WIDTH-1:0] PWDATA,

    input  wire [DATA_WIDTH-1:0] PRDATA,
    input  wire                  PREADY
);

    // APB FSM States
    localparam IDLE   = 2'b00;
    localparam SETUP  = 2'b01;
    localparam ACCESS = 2'b10;

    reg [1:0] state;

    always @(posedge PCLK or negedge PRESETn) begin
        if (!PRESETn) begin
            state      <= IDLE;
            PSEL       <= 1'b0;
            PENABLE    <= 1'b0;
            PWRITE     <= 1'b0;
            PADDR      <= {ADDR_WIDTH{1'b0}};
            PWDATA     <= {DATA_WIDTH{1'b0}};
            read_data  <= {DATA_WIDTH{1'b0}};
            done       <= 1'b0;
        end
        else begin
            done <= 1'b0;

            case (state)

                // Idle State
                IDLE: begin
                    PSEL    <= 1'b0;
                    PENABLE <= 1'b0;

                    if (start) begin
                        PADDR  <= address;
                        PWDATA <= write_data;
                        PWRITE <= write_enable;

                        state <= SETUP;
                    end
                end

                // APB Setup Phase
                SETUP: begin
                    PSEL    <= 1'b1;
                    PENABLE <= 1'b0;

                    state <= ACCESS;
                end

                // APB Access Phase
                ACCESS: begin
                    PSEL    <= 1'b1;
                    PENABLE <= 1'b1;

                    // Wait until slave is ready
                    if (PREADY) begin

                        // Read operation
                        if (!PWRITE)
                            read_data <= PRDATA;

                        done    <= 1'b1;
                        PENABLE <= 1'b0;
                        PSEL    <= 1'b0;

                        state <= IDLE;
                    end
                end

                default: begin
                    state <= IDLE;
                end

            endcase
        end
    end

endmodule